# Engine credentials: set exactly ONE of the two.
# The Harness never logs you in; you bring your own credentials (ADR 0001).

# Claude Pro/Max subscription token, generated with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=

# Or an Anthropic API key (billed per use).
ANTHROPIC_API_KEY=

# Telegram bot token from @BotFather. In the bot settings, turn on "Threaded mode"
# and "Disallow users to create new threads".
TELEGRAM_BOT_TOKEN=

# PostgreSQL: Compose uses this password for its local database.
# Local development default. Use URL-safe characters for the Compose connection URL.
POSTGRES_PASSWORD=emanator
# Native development URL; Compose supplies its own URL using the postgres hostname.
DATABASE_URL=postgresql://emanator:emanator@127.0.0.1:5432/emanator

# Encrypts Capability secrets (OAuth client secrets and tokens) in the database.
# Generate it once with `openssl rand -base64 32`; changing it loses every connection.
EMANATOR_SECRET_KEY=

# Optional
# EMANATOR_MODEL=sonnet
# EMANATOR_TIMEZONE=Europe/Rome
# EMANATOR_HTTP_PORT=3000
# How your browser reaches the dashboard; OAuth sign-ins come back to it.
# EMANATOR_DASHBOARD_URL=http://127.0.0.1:3000

# Google through workspace-mcp, which Compose starts with the Harness.
# The OAuth client of your Google Cloud project: the Harness uses both, workspace-mcp the ID.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Random, required by workspace-mcp at startup: `openssl rand -base64 32`.
# WORKSPACE_MCP_JWT_KEY=
# Only when the Harness runs with `pnpm dev`, outside Compose:
# WORKSPACE_MCP_URL=http://127.0.0.1:8001
