{
  "name": "emanator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx apps/server/src/main.ts",
    "dev:web": "pnpm --filter @emanator/web dev",
    "build": "pnpm --filter @emanator/web build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit && pnpm --filter @emanator/web typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
